// Recetarios de Aquí · Reglas de Cloud Firestore (js/auth.js, ARQUITECTURA.md §7.3).
// Publíquelas en la consola de Firebase: Firestore Database → Reglas → pegar → Publicar.
//
// users/{uid}:    { email, count, firstSeen, lastSeen, blocked? }  — sin contraseñas
// admins/{email}: { addedBy, addedAt, owner? }
// recipeMeta/{id}: { seasons, updatedBy, updatedAt }  — temporada fijada por un administrador (js/recipe-admin.js)
// reviews/{target}__{uid}: { target, uid, name, stars, text, hasPhoto?, status, createdAt, updatedAt }  — js/reviews.js
// reviewPhotos/{mismo id}: { target, uid, photo (data URL WebP/JPEG ya achicado por js/photo.js), updatedAt }
//
// Dueño (administrador fijo): ownerEmail(). Al entrar, la app le crea admins/{su correo} con owner: true.
// No se le puede quitar el rol ni suspender.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function ownerEmail() {
      return 'eduardo.padilla027@gmail.com';
    }
    function isOwner() {
      return verified() && myEmail() == ownerEmail();
    }
    function isAdmin() {
      return isOwner() || (verified() && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }

    match /users/{uid} {
      // Cada persona ve su registro; los administradores ven todos.
      allow read: if verified() && (request.auth.uid == uid || isAdmin());

      // Primera vez: sólo su correo validado, count = 1 y las fechas del servidor.
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'count', 'firstSeen', 'lastSeen'])
        && request.resource.data.email == myEmail()
        && request.resource.data.count == 1
        && request.resource.data.firstSeen == request.time
        && request.resource.data.lastSeen == request.time;

      // Cada uso: count sube exactamente 1 y lastSeen es la hora del servidor.
      allow update: if verified() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastSeen'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastSeen == request.time;

      // Administradores: suspender o reactivar el acceso, o borrar el registro.
      allow update: if isAdmin() && resource.data.email != ownerEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked'])
        && request.resource.data.blocked is bool;
      allow delete: if isAdmin() && resource.data.email != ownerEmail();
    }

    // Datos propios (ajustes de Planes): sólo la persona dueña; ni los administradores.
    match /users/{uid}/data/{docId} {
      allow read, delete: if verified() && request.auth.uid == uid;
      allow write: if verified() && request.auth.uid == uid
        && docId == 'plan'
        && request.resource.data.keys().hasOnly(['plan', 'updatedAt'])
        && request.resource.data.plan is map
        && request.resource.data.plan.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }

    match /admins/{email} {
      // Cada persona puede saber si ella misma es administradora.
      allow read: if verified() && (email == myEmail() || isAdmin());
      // Sólo el dueño puede marcarse owner: true (en su propio documento).
      allow create: if isAdmin()
        && (request.resource.data.get('owner', false) == false || (isOwner() && email == myEmail()));
      allow delete: if isAdmin() && email != ownerEmail() && resource.data.get('owner', false) != true;
    }

    // Temporada recomendada de una receta, corregida por un administrador (#/admin → Recetas).
    // La leen todos los que entran (los planes de comida la usan); sólo los administradores la escriben.
    match /recipeMeta/{id} {
      allow read: if verified();
      allow write: if isAdmin() && id.size() <= 100
        && request.resource.data.keys().hasOnly(['seasons', 'updatedBy', 'updatedAt'])
        && request.resource.data.seasons is list
        && request.resource.data.seasons.size() >= 1 && request.resource.data.seasons.size() <= 6
        && request.resource.data.seasons.hasOnly(['todo', 'navidad', 'cuaresma', 'verano', 'gracias', 'lluvia'])
        && request.resource.data.updatedBy == myEmail()
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Reseñas (js/reviews.js): reviews/{target}__{uid}, target 'app' o 'r:<id de la receta>'.
    // Una por persona y por receta (y una de la app). Aprobación previa: el autor sólo
    // escribe 'pending'; un administrador la pasa a 'approved'. El correo no se guarda aquí.
    match /reviews/{rid} {
      function validReview() {
        let d = request.resource.data;
        return d.keys().hasOnly(['target', 'uid', 'name', 'stars', 'text', 'hasPhoto', 'status', 'createdAt', 'updatedAt'])
          && d.get('hasPhoto', false) is bool
          && d.uid == request.auth.uid
          && (d.target == 'app' || d.target.matches('r:[^/]{1,100}'))
          && rid == d.target + '__' + request.auth.uid
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 40
          && d.stars is int && d.stars >= 1 && d.stars <= 5
          && d.text is string && d.text.size() <= 1000
          && d.status == 'pending'
          && d.updatedAt == request.time
          && !(exists(/databases/$(database)/documents/users/$(request.auth.uid))
               && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) == true);
      }

      // Publicadas: todos los que entran. Pendientes: su autor y los administradores.
      allow get: if verified() && (resource == null || resource.data.status == 'approved'
        || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if verified() && (resource.data.status == 'approved' || isAdmin());

      // Escribir o editar la propia: siempre vuelve a 'pending'.
      allow create: if verified() && validReview() && request.resource.data.createdAt == request.time;
      allow update: if verified() && resource.data.uid == request.auth.uid && validReview()
        && request.resource.data.createdAt == resource.data.createdAt;

      // Administradores: sólo cambian el estado (aprobar).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'pending'];

      // Borrar: su autor o un administrador.
      allow delete: if verified() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Foto de una reseña (js/photo.js + js/reviews.js), aparte para que las listas no la descarguen.
    // Se ve con las mismas condiciones que su reseña: publicada, o su autor, o un administrador.
    match /reviewPhotos/{rid} {
      allow get: if verified() && (resource == null || resource.data.uid == request.auth.uid || isAdmin()
        || (exists(/databases/$(database)/documents/reviews/$(rid))
            && get(/databases/$(database)/documents/reviews/$(rid)).data.status == 'approved'));

      // Sólo el autor; ≤ 250,000 caracteres (la app la deja en ≈ 160,000) y sólo imagen WebP o JPEG en base64.
      allow create, update: if verified()
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['target', 'uid', 'photo', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.target == 'app' || request.resource.data.target.matches('r:[^/]{1,100}'))
        && rid == request.resource.data.target + '__' + request.auth.uid
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 250000
        && request.resource.data.photo.matches('data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+')
        && request.resource.data.updatedAt == request.time
        && !(exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) == true);

      // Borrar: su autor o un administrador (junto con la reseña). Si ya no existe, no estorba al batch.
      allow delete: if verified() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
